std_msgs/Header header
float64 x       # GPS-like position [m]
float64 y       # GPS-like position [m]
float64 psi     # compass/AHRS heading [rad]
float64 r       # rate-gyro yaw rate [rad/s]
float64 ax      # body-frame IMU accelerometer, surge axis [m/s^2]
float64 ay      # body-frame IMU accelerometer, sway axis [m/s^2]
float64 delta   # rudder encoder reading [rad]
float64 n       # propeller-speed encoder reading [rps]
