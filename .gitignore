# Live-run debug logs (large, repetitive, regenerated by mpc_visualization/run_live_open_loop.py)
mpc_visualization/logs/*.csv

# Copyrighted reference papers (cited by title/DOI in research_papers/README.md instead)
research_papers/*.pdf

# Raw AI coding-assistant chat history exports (internal working notes, not project source)
md/
chat_history_exports/

# Editor / OS
.DS_Store

# Local Claude Code permission settings (machine-specific, not project source)
.claude/settings.local.json
