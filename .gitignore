# Python bytecode / caches
__pycache__/
*.pyc
*.pyo

# Acados code-generation & build artifacts (regenerated automatically on first solver run)
c_generated_code_sim_exact/
c_generated_code_sim_smooth/
c_generated_code_nmpc/
acados_nmpc.json
acados_sim.json

# Live-run debug logs & simulation experiment outputs
mpc_visualization/logs/*.csv
nmpc_sim_logs/

# ROS2 colcon build artifacts (regenerated by `python3 -m colcon build`)
nmpc_ws/build/
nmpc_ws/install/
nmpc_ws/log/

# Copyrighted reference papers (cited by title/DOI in research_papers/README.md instead)
research_papers/*.pdf

# Raw AI coding-assistant chat history exports (internal working notes, not project source)
md/
chat_history_exports/

# Editor / OS
.DS_Store
/.vscode

# Local Claude Code permission settings (machine-specific, not project source)
.claude/settings.local.json
